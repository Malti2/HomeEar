{
  "sourceLanguage": "en",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HomeEar transcribes microphone audio on this Mac and sends only matched text requests to your selected backend."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HomeEar transkribiert Mikrofon-Audio auf diesem Mac und sendet nur passende Textanfragen an dein gewähltes Backend."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HomeEar uses on-device speech recognition to understand your voice requests."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HomeEar nutzt die Spracherkennung auf dem Gerät, um deine Sprachanfragen zu verstehen."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HomeEar connects to your configured Home Assistant server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HomeEar verbindet sich mit deinem eingerichteten Home-Assistant-Server."
          }
        }
      }
    },
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HomeEar"
          }
        },
        "de": {
