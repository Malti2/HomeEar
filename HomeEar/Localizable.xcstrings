    "Home Assistant": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant"
          }
        }
      }
    },
    "Home Assistant URL": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Home-Assistant-URL"
          }
        }
      }
    },
    "Home Assistant answers are read aloud. While HomeEar speaks, and for a moment after, microphone input is ignored so it never hears itself. Poke speaks through its own voice tool either way.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworten von Home Assistant werden vorgelesen. Während HomeEar spricht und kurz danach, wird das Mikrofon ignoriert, damit es sich nie selbst hört. Poke spricht in jedem Fall über sein eigenes Sprach-Werkzeug."
          }
        }
      }
    },
    "Home Assistant names": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Home-Assistant-Namen"
          }
        }
      }
    },
    "Home Assistant rejected the token.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant hat das Token abgelehnt."
          }
        }
      }
    },
    "Home Assistant returned HTTP %lld; request not retried.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant antwortete mit HTTP %lld; Anfrage nicht wiederholt."
          }
        }
      }
    },
    "Home Assistant returned an unexpected response.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant hat eine unerwartete Antwort geliefert."
          }
        }
      }
    },
    "Home Assistant: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant: %@"
          }
        }
      }
    },
    "Home Assistant: result unconfirmed; no retry": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant: Ergebnis unbestätigt; keine Wiederholung"
          }
        }
      }
    },
    "HomeEar needs microphone and Speech Recognition access.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HomeEar braucht Zugriff auf Mikrofon und Spracherkennung."
          }
        }
      }
    },
    "HomeEar transcribes on your Mac. Only text that looks like a request is sent to your selected backend. It can still mishear background speech, so pause it when you need privacy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HomeEar transkribiert auf deinem Mac. Nur Text, der wie eine Anfrage aussieht, geht an dein gewähltes Backend. Es kann Hintergrundsprache trotzdem falsch verstehen, also pausiere es, wenn du Privatsphäre brauchst."
          }
        }
      }
    },
    "Ignore distant speech (TV, other rooms)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernte Sprache ignorieren (TV, andere Räume)"
          }
        }
      }
    },
